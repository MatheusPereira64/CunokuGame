{
  "appId": "com.cunoku.game",
  "appName": "Cunoku",
  "webDir": "dist/public",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "Cunoku"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#1c1917"
    }
  }
}
